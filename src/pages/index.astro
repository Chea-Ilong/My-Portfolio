      { name: 'MySQL', icon: '/icons/skills/mysql-original-wordmark.svg', url: 'https://www.mysql.com/' },
      { name: 'MariaDB', icon: '/icons/skills/mariadb-icon.svg', url: 'https://mariadb.org/' },
