    heroDescription: 'ខ្ញុំជាវិស្វករកម្មវិធីដែលផ្តោតលើការបង្កើតដំណោះស្រាយឌីជីថលប្រកបដោយគុណភាព។ ខ្ញុំមានជំនាញក្នុងការអភិវឌ្ឍ full-stack នវានុវត្តន៍ស្តាតអាប់ និងការប្រែក្លាយគំនិតទៅជាផលិតផលដែលអាចដាក់ឱ្យប្រើប្រាស់បាន។',
    viewProjects: 'មើលគម្រោង',
    contactMe: 'ទាក់ទងខ្ញុំ',
    about: 'អំពីខ្ញុំ',
    aboutHeading: 'វិស្វកម្មដែលគិតគូរពីផលិតផល',
    aboutDescription: 'ខ្ញុំមានបទពិសោធន៍ជាក់ស្តែងក្នុងការអភិវឌ្ឍ full-stack ការអនុវត្តស្តាតអាប់ និងភាពជាអ្នកដឹកនាំផ្នែកបច្ចេកទេស។ ខ្ញុំបង្កើតប្រព័ន្ធដែលងាយស្រួលថែទាំ និងអាចឱ្យអ្នកប្រើប្រាស់ទុកចិត្តបាន។',
    currentlyWorking: 'កំពុងធ្វើការ',
    currentWork: 'LeakScope - ឧបករណ៍ស្កេនសុវត្ថិភាព Supabase។',
    learning: 'កំពុងសិក្សា',
    learningValue: 'ការអភិវឌ្ឍកម្មវិធី និងមូលដ្ឋានគ្រឹះ AWS Cloud',
    internshipExperience: 'បទពិសោធន៍កម្មសិក្សា',
    volunteerExperience: 'បទពិសោធន៍ស្ម័គ្រចិត្ត',
    skills: 'ជំនាញ',
    projects: 'គម្រោង',
    contact: 'ទាក់ទងមកខ្ញុំ',
    contactDescription: 'ខ្ញុំតែងតែចាប់អារម្មណ៍ក្នុងការស្វែងយល់អំពីគម្រោង និងឱកាសថ្មីៗ។ ប្រសិនបើអ្នកចង់ពិភាក្សាអំពីកិច្ចសហការ មានសំណួរ ឬគ្រាន់តែចង់សួរសុខទុក្ខ សូមទាក់ទងមកខ្ញុំដោយសេរី។',
    email: 'អ៊ីមែល',
  },
} satisfies Record<Language, Record<string, string>>;

---

<BaseLayout>
  <div class="min-h-screen overflow-x-clip bg-background text-foreground antialiased">
    <main>
      <SiteHeader page="home" />

      <!-- Hero Section with Profile -->
      <section class="px-5 pb-28 pt-36 sm:px-8 sm:pb-32 sm:pt-40 lg:pb-40 lg:pt-44">
        <div class="mx-auto max-w-6xl">
          <div class="grid items-center gap-14 md:grid-cols-[1.1fr_0.9fr] md:gap-16 lg:gap-24">
            <div class="space-y-10">
              <h1
                class="hero-heading text-5xl font-normal leading-[1.04] text-foreground sm:text-6xl lg:text-7xl xl:text-8xl"
                data-reveal-item
              >
                <span data-en={copy.en.heroLine1} data-km={copy.km.heroLine1}>{copy.en.heroLine1}</span>
                <br />
                <span data-en={copy.en.heroLine2} data-km={copy.km.heroLine2}>{copy.en.heroLine2}</span>
              </h1>
              <p
                data-reveal-item
                style="--reveal-delay: 90ms"
                class="max-w-lg text-base font-normal leading-relaxed text-body sm:text-lg"
                data-en={copy.en.heroDescription}
                data-km={copy.km.heroDescription}
              >
                {copy.en.heroDescription}
              </p>
              <div class="flex flex-wrap gap-3 pt-2" data-reveal-item style="--reveal-delay: 180ms">
                <a
                  href="#projects"
                  class="group inline-flex items-center gap-3 rounded-lg bg-foreground px-6 py-3.5 text-sm font-medium text-background transition-[background-color,transform] duration-300 ease-soft hover:-translate-y-px hover:bg-foreground/85"
                >
                  <span data-en={copy.en.viewProjects} data-km={copy.km.viewProjects}>{copy.en.viewProjects}</span>
                  <ArrowRight class="h-4 w-4 transition-transform duration-300 ease-soft group-hover:translate-x-0.5" />
                </a>
                <a
                  href="#contact"
                  class="inline-flex items-center rounded-lg border border-border bg-card px-6 py-3.5 text-sm font-normal text-foreground transition-[background-color,border-color,transform] duration-300 ease-soft hover:-translate-y-px hover:border-foreground/25 hover:bg-muted/40"
                  data-en={copy.en.contactMe}
                  data-km={copy.km.contactMe}
                >
                  {copy.en.contactMe}
                </a>
              </div>
              <div class="flex items-center gap-2" data-reveal-item style="--reveal-delay: 240ms">
                {heroSocials.map((social) => (
                  <a
                    href={social.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={social.label}
                    class="grid h-11 w-11 place-items-center rounded-lg border border-border bg-card text-strong transition-[background-color,border-color,color,transform] duration-300 ease-soft hover:-translate-y-px hover:border-foreground/25 hover:bg-muted/40 hover:text-foreground"
                  >
                    <BrandIcon name={social.icon} class="h-5 w-5" />
                  </a>
                ))}
              </div>
            </div>
            <div class="flex justify-center md:justify-end" data-reveal-item style="--reveal-delay: 120ms">
              <div class="aspect-[5/6] w-full max-w-80 overflow-hidden rounded-lg border border-border/70 bg-card shadow-[0_20px_50px_rgba(0,0,0,0.06)]">
                <Image
                  src={profileImage}
                  alt="Chea Ilong"
                  width={320}
                  height={384}
                  widths={[320, 640]}
                  sizes="320px"
                  class="h-full w-full object-cover"
                  loading="eager"
                  fetchpriority="high"
                />
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- About Section -->
      <section id="about" class="border-t border-border/70 bg-muted/20 px-5 py-24 sm:px-8 sm:py-32">
        <div class="mx-auto max-w-6xl">
          <div>
            <div class="space-y-6" data-reveal-item>
              <p class="text-xs font-medium uppercase text-muted-foreground" data-en={copy.en.about} data-km={copy.km.about}>{copy.en.about}</p>
              <h2 class="max-w-2xl text-4xl font-normal leading-tight sm:text-5xl" data-en={copy.en.aboutHeading} data-km={copy.km.aboutHeading}>{copy.en.aboutHeading}</h2>
            </div>
            <div class="grid gap-12 pt-12 md:grid-cols-2">
              <p class="max-w-xl text-body" data-reveal-item data-en={copy.en.aboutDescription} data-km={copy.km.aboutDescription}>
                {copy.en.aboutDescription}
              </p>
              <div data-reveal-item style="--reveal-delay: 90ms" class="space-y-6 rounded-lg border border-border/70 bg-card p-7 shadow-[0_8px_24px_rgba(0,0,0,0.035)] sm:p-8">
                <p class="text-xs font-medium uppercase text-muted-foreground" data-en={copy.en.currentlyWorking} data-km={copy.km.currentlyWorking}>{copy.en.currentlyWorking}</p>
                <p class="font-semibold text-foreground" data-en={copy.en.currentWork} data-km={copy.km.currentWork}>{copy.en.currentWork}</p>
                <p class="pt-4 text-xs font-medium uppercase text-muted-foreground" data-en={copy.en.learning} data-km={copy.km.learning}>{copy.en.learning}</p>
                <p class="font-semibold text-foreground" data-en={copy.en.learningValue} data-km={copy.km.learningValue}>{copy.en.learningValue}</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Experience Section -->
      <section id="experience" class="border-t border-border/70 bg-background px-5 py-24 sm:px-8 sm:py-32">
        <div class="mx-auto max-w-6xl space-y-24 sm:space-y-32">
          <!-- Internship -->
          <div class="space-y-14">
            <div class="text-center">
              <h2 data-reveal-item class="text-4xl font-normal text-foreground sm:text-5xl" data-en={copy.en.internshipExperience} data-km={copy.km.internshipExperience}>{copy.en.internshipExperience}</h2>
            </div>
            <div class="space-y-8">
              {internships.map((job) => (
                <div
                  data-reveal-item
                  class="group rounded-lg border border-border/60 bg-card/50 p-5 transition-[background-color,border-color,box-shadow,transform] duration-300 ease-soft hover:-translate-y-px hover:border-border hover:bg-card hover:shadow-[0_14px_40px_rgba(0,0,0,0.055)] sm:p-6"
                >
                  <div class="space-y-4">
                    <div class="flex items-start gap-4">
                      <Image
                        src={job.logo}
                        alt={`${job.company} logo`}
                        widths={[56, 112]}
                        sizes="56px"
                        class="h-14 w-14 shrink-0 rounded-md border border-border/60 bg-white object-contain"
                        loading="lazy"
                      />
                      <div class="space-y-1">
                        <h3 class="text-xl font-semibold text-foreground sm:text-2xl" data-en={job.role} data-km={job.roleKm}>{job.role}</h3>
                        <!-- Translated parts are their own spans: textContent swaps
                             would wipe the separator and the untranslated name. -->
                        <p class="text-base text-strong">
                          {job.company} · <span data-en={job.type} data-km={job.typeKm}>{job.type}</span>
                        </p>
                        <p class="text-sm tabular-nums text-muted-foreground">
                          <span data-en={job.period} data-km={job.periodKm}>{job.period}</span> · <span data-en={job.duration} data-km={job.durationKm}>{job.duration}</span>
                        </p>
                      </div>
                    </div>
                    <p class="text-base font-normal leading-relaxed text-body" data-en={job.description} data-km={job.descriptionKm}>
                      {job.description}
                    </p>
                    <div class="flex flex-wrap gap-2 pt-2">
                      {job.highlights.map((highlight, index) => (
                        <span
                          class="rounded-md border border-border/60 bg-muted/50 px-2.5 py-1 text-xs font-medium text-muted-foreground"
                          data-en={highlight}
                          data-km={job.highlightsKm[index]}
                        >
                          {highlight}
                        </span>
                      ))}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Volunteer -->
          <div class="space-y-14">
            <div class="text-center">
              <h2 data-reveal-item class="text-4xl font-normal text-foreground sm:text-5xl" data-en={copy.en.volunteerExperience} data-km={copy.km.volunteerExperience}>{copy.en.volunteerExperience}</h2>
            </div>
            <div class="relative">
              <div class="space-y-8">
                {experiences.map((exp, index) => (
                  <div class="group relative pl-10 sm:pl-12" data-reveal-item style={`--reveal-delay: ${index * 70}ms`}>
                    <!-- Rail, drawn per entry from this node's centre to the next one's,
                         and skipped on the last. A single rail spanning the container
                         overshot both the first and last node; fading it out instead
                         left the tail entries looking like the line had gone missing.
                         The negative bottom crosses the 2rem space-y gap plus the next
                         node's own top offset. -->
                    {index < experiences.length - 1 && (
                      <div class="absolute -bottom-[60px] left-2 top-7 w-px bg-border sm:-bottom-16 sm:top-8" />
                    )}

                    <!-- Branch tick: runs from the axis to the card's left border, so it
                         lands on something instead of ending in mid-air. -->
                    <div class="absolute left-2 top-7 h-px w-8 bg-border sm:top-8 sm:w-10" />

                    <!-- Node. At 16px solid it outweighed even the entry titles next to
                         a 1px rail and hairline card borders; 8px keeps it as
                         punctuation on the rail instead of the loudest mark on the
                         page. Offsets stay on the spacing scale and centre it on the
                         rail: left-1 + half of w-2 = the rail's left-2, and top-6 +
                         half of h-2 = the rail's top-7. The background ring still
                         punches a clean 16px hole in the rail and tick underneath, and
                         the hover step is larger because 110% of 8px reads as nothing. -->
                    <div
                      class="absolute left-1 top-6 h-2 w-2 rounded-full bg-foreground ring-4 ring-background transition-transform duration-300 ease-soft group-hover:scale-150 sm:top-7"
                    />

                    <!-- Same card treatment as the Projects entries: the bare content
                         next to a bordered image read as two different systems. -->
                    <div
                      class="rounded-lg border border-border/60 bg-card/50 p-5 transition-[background-color,border-color,box-shadow,transform] duration-300 ease-soft hover:-translate-y-px hover:border-border hover:bg-card hover:shadow-[0_14px_40px_rgba(0,0,0,0.055)] sm:p-6"
                    >
                      <div class="grid items-start gap-6 md:grid-cols-3">
                        <!-- Content -->
                        <div class="space-y-3 md:col-span-2">
                          <!-- Period leads the entry as an eyebrow, matching the year
                               above each project title. It used to sit right-aligned
                               against the 2/3 column, which floated it mid-page. -->
                          <p
                            class="text-xs font-medium uppercase tabular-nums text-muted-foreground"
                            data-en={exp.period}
                            data-km={exp.periodKm}
                          >
                            {exp.period}
                          </p>
                          <h3 class="text-xl font-semibold text-foreground sm:text-2xl">{exp.company}</h3>
                          <p class="text-base font-medium text-strong" data-en={exp.role} data-km={exp.roleKm}>{exp.role}</p>
                          <p class="text-base font-normal leading-relaxed text-body" data-en={exp.description} data-km={exp.descriptionKm}>
                            {exp.description}
                          </p>
                          <div class="flex flex-wrap gap-2 pt-2">
                            {exp.highlights.map((highlight, index) => (
                              <span
                                class="rounded-md border border-border/60 bg-muted/50 px-2.5 py-1 text-xs font-medium text-muted-foreground"
                                data-en={highlight}
                                data-km={exp.highlightsKm[index]}
                              >
                                {highlight}
                              </span>
                            ))}
                          </div>
                        </div>

                        <!-- Experience Image -->
                        {exp.image && (
                          <div class="relative h-44 w-full overflow-hidden rounded-md border border-border/60 bg-muted/20 sm:h-48">
                            <Image
                              src={exp.image}
                              alt={exp.company}
                              widths={[400, 800]}
                              sizes="(max-width: 768px) 100vw, 33vw"
                              class="h-full w-full object-cover transition-transform duration-500 ease-soft group-hover:scale-[1.015]"
                              loading="lazy"
                            />
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Projects Section -->
      <section id="projects" class="border-t border-border/70 bg-muted/20 px-5 py-24 sm:px-8 sm:py-32">
        <div class="mx-auto max-w-6xl">
          <div class="space-y-14">
            <div class="text-center">
              <h2 data-reveal-item class="text-4xl font-normal text-foreground sm:text-5xl" data-en={copy.en.projects} data-km={copy.km.projects}>{copy.en.projects}</h2>
            </div>
            <div class="space-y-8">
              {projects.slice(0, homeProjectCount).map((project, index) => (
                <ProjectCard project={project} index={index} />
              ))}
            </div>
            {projects.length > homeProjectCount && (
              <div class="flex justify-center" data-reveal-item>
                <!-- Lands on the first project the home page left out, not the top of the list. -->
                <a
                  href={`/projects/#${projectId(projects[homeProjectCount])}`}
                  class="group inline-flex items-center gap-2 rounded-full bg-foreground px-7 py-3.5 text-sm font-medium uppercase text-background transition-[background-color,transform] duration-300 ease-soft hover:-translate-y-px hover:bg-foreground/85 [html[lang='en']_&]:tracking-wide"
                >
                  <span data-en={siteCopy.en.seeMore} data-km={siteCopy.km.seeMore}>{siteCopy.en.seeMore}</span>
                  <ChevronsRight class="h-4 w-4 transition-transform duration-300 ease-soft group-hover:translate-x-0.5" />
                </a>
              </div>
            )}
          </div>
        </div>
      </section>

      <!-- Skills Section -->
      <section id="skills" class="border-t border-border/70 bg-background px-5 py-24 sm:px-8 sm:py-32">
        <div class="mx-auto max-w-6xl">
          <div class="space-y-14">
            <div class="text-center">
              <h2 data-reveal-item class="text-4xl font-normal text-foreground sm:text-5xl" data-en={copy.en.skills} data-km={copy.km.skills}>{copy.en.skills}</h2>
            </div>
            <div class="mx-auto grid max-w-5xl gap-14 md:grid-cols-2 md:gap-12 lg:gap-16">
              {skills.map((skillGroup, index) => (
                <div class="space-y-6" data-reveal-item style={`--reveal-delay: ${index * 70}ms`}>
                  <h3 class="text-lg font-semibold text-foreground" data-en={skillGroup.category} data-km={skillGroup.categoryKm}>{skillGroup.category}</h3>
                  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                    {skillGroup.items.map((skill) => (
                      <a
                        href={skill.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group/skill flex items-center gap-4 rounded-lg border border-border/60 bg-card/60 p-4 transition-[background-color,border-color,box-shadow,transform] duration-300 ease-soft hover:-translate-y-px hover:border-border hover:bg-card hover:shadow-sm"
                      >
                        <img
                          src={skill.icon}
                          alt={skill.name}
                          width={32}
                          height={32}
                          class="w-8 h-8 shrink-0 object-contain"
                          loading="lazy"
                        />
                        <span class="text-sm font-normal text-body transition-colors duration-300 ease-soft group-hover/skill:text-foreground">
                          {skill.name}
                        </span>
                      </a>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- Contact Section -->
      <section id="contact" class="border-t border-border/70 bg-muted/20 px-5 py-24 sm:px-8 sm:py-32">
        <div class="mx-auto max-w-6xl">
          <div class="space-y-14">
            <div class="text-center">
              <h2 data-reveal-item class="text-4xl font-normal text-foreground sm:text-5xl" data-en={copy.en.contact} data-km={copy.km.contact}>{copy.en.contact}</h2>
            </div>
            <div class="mx-auto max-w-3xl space-y-12">
              <p
                data-reveal-item
                class="text-center text-lg font-normal leading-relaxed text-body"
                data-en={copy.en.contactDescription}
                data-km={copy.km.contactDescription}
              >
                {copy.en.contactDescription}
              </p>
              <div class="grid grid-cols-1 gap-6 sm:grid-cols-2" data-reveal-item style="--reveal-delay: 90ms">
                <a
                  href="mailto:cheadara133@gmail.com"
                  class="group flex items-center gap-4 rounded-lg border border-border/70 bg-card/60 p-5 transition-[background-color,border-color,box-shadow,transform] duration-300 ease-soft hover:-translate-y-px hover:border-border hover:bg-card hover:shadow-sm sm:p-6"
                >
                  <div class="flex-shrink-0">
                    <Mail class="w-6 h-6 text-strong group-hover:text-foreground transition-colors" />
                  </div>
                  <div class="min-w-0">
                    <p class="mb-0.5 text-xs font-medium uppercase text-muted-foreground" data-en={copy.en.email} data-km={copy.km.email}>{copy.en.email}</p>
                    <span class="truncate text-sm font-semibold text-foreground">cheadara133@gmail.com</span>
                  </div>
                </a>
                <a
                  href="https://www.linkedin.com/in/chea-ilong-88bb83333/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center gap-4 rounded-lg border border-border/70 bg-card/60 p-5 transition-[background-color,border-color,box-shadow,transform] duration-300 ease-soft hover:-translate-y-px hover:border-border hover:bg-card hover:shadow-sm sm:p-6"
                  aria-label="LinkedIn"
                >
                  <BrandIcon name="linkedin" class="h-6 w-6 flex-shrink-0 text-strong transition-colors group-hover:text-foreground" />
                  <span class="text-sm font-semibold text-foreground">LinkedIn</span>
                </a>
                <a
                  href="https://github.com/Chea-Ilong"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center gap-4 rounded-lg border border-border/70 bg-card/60 p-5 transition-[background-color,border-color,box-shadow,transform] duration-300 ease-soft hover:-translate-y-px hover:border-border hover:bg-card hover:shadow-sm sm:p-6"
                  aria-label="GitHub"
                >
                  <BrandIcon name="github" class="h-6 w-6 flex-shrink-0 text-strong transition-colors group-hover:text-foreground" />
                  <span class="text-sm font-semibold text-foreground">GitHub</span>
                </a>
                <a
                  href="https://t.me/Chea_Ilong"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center gap-4 rounded-lg border border-border/70 bg-card/60 p-5 transition-[background-color,border-color,box-shadow,transform] duration-300 ease-soft hover:-translate-y-px hover:border-border hover:bg-card hover:shadow-sm sm:p-6"
                  aria-label="Telegram"
