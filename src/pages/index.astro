    categoryKm: 'DevOps និងឧបករណ៍',
    items: [
      { name: 'Docker', icon: '/icons/skills/docker-original-wordmark.svg', url: 'https://www.docker.com/' },
      { name: 'Git', icon: '/icons/skills/git-scm-icon.svg', url: 'https://git-scm.com/' },
      { name: 'Linux', icon: '/icons/skills/linux-original.svg', url: 'https://www.linux.org/' },
      { name: 'Postman', icon: '/icons/skills/getpostman-icon.svg', url: 'https://postman.com/' },
